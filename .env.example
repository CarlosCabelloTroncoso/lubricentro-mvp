# ---------------------------------------------------------------
# Copiar este archivo a .env y ajustar los valores.
#   cp .env.example .env
# El .env real NUNCA se sube a Git (ya esta en .gitignore).
# ---------------------------------------------------------------

# Entorno de ejecucion. Controla el detalle de los errores devueltos por la API.
NODE_ENV=development

# Puerto de escucha de Express.
PORT=3000

# --- Base de datos -----------------------------------------------
# En desarrollo la API corre en local y MySQL en Docker -> localhost:3307
# Dentro de docker compose, el servicio api sobreescribe estos dos valores
# con DB_HOST=db y DB_PORT=3306 (red interna).
DB_HOST=localhost
DB_PORT=3307

DB_USER=lubricentro_app
DB_PASSWORD=cambiar_este_valor
DB_NAME=lubricentro

# Password de root de MySQL. Solo la usa la imagen oficial para inicializarse.
MYSQL_ROOT_PASSWORD=cambiar_este_valor

# --- Seguridad ---------------------------------------------------
# Clave HMAC para firmar el JWT. Generar una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generar_una_clave_aleatoria_de_32_bytes
